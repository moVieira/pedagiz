PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pedagix

JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=7d

UPLOAD_DIR=uploads

# Mercado Pago (pagamentos via Pix)
MP_ACCESS_TOKEN=
MP_WEBHOOK_URL=https://seu-dominio.com/api/payments/webhook
# Chave secreta gerada ao cadastrar o webhook no painel do Mercado Pago —
# usada para validar o header x-signature das notificações recebidas.
MP_WEBHOOK_SECRET=

# URL do frontend (CORS / links de retorno)
FRONTEND_URL=http://localhost:5500

# URL pública da própria API (usada nos links de download enviados por
# e-mail). Se não configurada, cai no FRONTEND_URL.
PUBLIC_API_URL=http://localhost:3000

# E-mail (envio do material comprado após o pagamento ser aprovado).
# Sem SMTP_HOST configurado, o envio é apenas pulado (com aviso no log).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Pedagix <no-reply@pedagiz.com>
